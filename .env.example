# ============================================================
# Clan Maromba — variáveis de ambiente
#
# Como usar no seu computador:
#   1. Copie este arquivo com o nome  .env.local  (na raiz do projeto)
#   2. Preencha os valores seguindo o guia  docs/fase-0-configuracao.md
#   O .env.local NUNCA vai para o GitHub (está no .gitignore).
#
# Como usar na Vercel:
#   Projeto -> Settings -> Environment Variables -> cole nome e valor de cada uma.
#
# REGRA DE OURO: variáveis que começam com NEXT_PUBLIC_ podem aparecer no
# navegador (são públicas). Todas as outras são SEGREDOS — nunca compartilhe.
# ============================================================

# --- Site ---------------------------------------------------
# Endereço público do site (sem barra no final).
# Ex.: https://clan-maromba.vercel.app  (depois vira seu domínio próprio)
NEXT_PUBLIC_SITE_URL=

# --- Supabase (login, banco de dados, sessão única) ---------
# Guia: docs/fase-0-configuracao.md -> Passo 1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare Stream (recebe o OBS e entrega o vídeo) -----
# Guia: docs/fase-0-configuracao.md -> Passo 2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Só a parte XXXX de customer-XXXX.cloudflarestream.com
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# Chave que assina os tokens de reprodução do vídeo (Fase 1).
# Gere as duas em  SEU-SITE/admin/configuracao  e cole aqui.
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_JWK=

# --- Mercado Pago (pagamentos Pix e cartão) -----------------
# Guia: docs/fase-0-configuracao.md -> Passo 3
# Use o Access Token de TESTE (começa com TEST-) até a Fase 3.
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (Fase 1).
# Guia: docs/fase-1-ligar-tudo.md -> Passo 3
MP_WEBHOOK_SECRET=
